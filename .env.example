# Copy to .env (or export these) before starting. Everything is optional for local testing.
PORT=3000
# Public address of the app. MUST match what clients open and the Google redirect URI below.
BASE_URL=http://localhost:3000
# Only people with this code can register a new salon (leave empty for open sign-up)
REGISTRATION_CODE=
# Google Calendar sync (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
