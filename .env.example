# Copy to .env (or export these) before starting. Everything is optional for local testing.
PORT=3000
# Public address of the app. MUST match what clients open and the Google redirect URI below.
BASE_URL=http://localhost:3000
# Only people with this code can register a new salon (leave empty for open sign-up)
REGISTRATION_CODE=
# Google Calendar sync (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email notifications to salon owners (Gmail: smtp.gmail.com, port 465, your address, and an App Password,
# created at https://myaccount.google.com/apppasswords; it needs 2-Step Verification on).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# MMG checkout padding. Leave as sha256 unless MMG's sandbox reports "Token Decryption Failed".
MMG_OAEP_HASH=sha256
